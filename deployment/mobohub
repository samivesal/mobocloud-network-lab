#!/bin/sh
set -eu
export LC_ALL=C.UTF-8

service=mobohub-lab.service
settings=/etc/mobohub-network-lab/settings
release=/opt/mobohub-lab/current

manage() {
    if [ "$(id -u)" -ne 0 ]; then
        printf '%s\n' 'Run sudo mobocloud to use this option.' >&2
        return 1
    fi
    (cd "$release" && LAB_KEY_DIR=/etc/mobohub-network-lab/keys .venv/bin/python "$@")
}

address() {
    port=
    if [ -r "$settings" ]; then
        port=$(sed -nE "s/^[[:space:]]*LAB_PORT[[:space:]]*=[[:space:]]*['\"]?([0-9]{1,5})['\"]?[[:space:]]*$/\1/p" "$settings" | tail -n 1)
    fi
    printf 'http://127.0.0.1:%s\n' "${port:-8765}"
}

action() {
    case "$1" in
        status) systemctl --no-pager status "$service" ;;
        address) address ;;
        health)
            curl -q --fail --silent --noproxy '*' --max-time 2 "$(address)/health" |
                python3 -c 'import json,sys; sys.exit(0 if json.load(sys.stdin)["worker_alive"] else 1)'
            ;;
        logs) journalctl --no-pager -u "$service" -n 60 ;;
        restart) systemctl restart "$service" ;;
        settings)
            if manage -m lab.manage "$settings"; then
                systemctl restart "$service"
            else
                status=$?
                [ "$status" -eq 3 ] || return "$status"
            fi
            ;;
        reset-password)
            manage -m lab.main reset-password || return "$?"
            systemctl restart "$service" || return "$?"
            printf '%s\n' 'Administrator password changed. Sign in with the new password.'
            ;;
        *) printf '%s\n' 'Usage: mobocloud [status|address|health|logs|restart|settings|reset-password]' >&2; return 2 ;;
    esac
}

if [ "$#" -gt 0 ]; then
    action "$1"
    exit
fi

while :; do
    printf '\nMobocloud Network Lab · %s\n' "$(address)"
    printf '%s\n' '1) Service status' '2) Service logs' '3) Restart service' '4) Settings' '5) Reset administrator password' '0) Exit'
    printf '%s' 'Select: '
    IFS= read -r choice || break
    case "$choice" in
        1) action status || : ;;
        2) action logs || : ;;
        3) action restart || : ;;
        4) action settings || : ;;
        5) action reset-password || : ;;
        0) break ;;
        *) printf '%s\n' 'Enter a menu option.' ;;
    esac
done
